# 复制为 .env.enterprise-demo 后替换所有示例凭据；不要提交真实文件。

# 授权插件由 Core 按通用模块契约加载；Core 不包含 OpenFGA 配置与实现。
RCS_AUTHORIZATION_PLUGIN_MODULE=@fenix/openfga-authorization-plugin

# FenixAgent 业务 PostgreSQL。默认映射 5433，避免与现有社区开发环境冲突。
RCS_POSTGRES_USER=rcs_demo
RCS_POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
RCS_POSTGRES_DB=rcs_demo
RCS_POSTGRES_PORT=5433
DATABASE_URL=postgres://rcs_demo:replace-with-a-long-random-postgres-password@localhost:5433/rcs_demo

# Redis
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_PORT=6380
REDIS_URL=redis://:replace-with-a-long-random-redis-password@localhost:6380/0

# OpenFGA。宿主机 FenixAgent 使用 localhost；Compose 网络内服务使用 http://openfga:8080。
OPENFGA_POSTGRES_USER=openfga_demo
OPENFGA_POSTGRES_PASSWORD=replace-with-a-long-random-openfga-postgres-password
OPENFGA_POSTGRES_DB=openfga_demo
OPENFGA_HTTP_PORT=8080
OPENFGA_GRPC_PORT=8082
RCS_OPENFGA_API_URL=http://localhost:8080
RCS_OPENFGA_STORE_ID=
RCS_OPENFGA_MODEL_ID=


# MinIO
MINIO_ROOT_USER=fenix-demo-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_AUDIT=fenix-audit-demo
MINIO_ENDPOINT=http://localhost:9000
