{
  "name": "fenix-agent-v4-architecture-scaffold",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "apps/*"
  ],
  "scripts": {
    "dev:community": "bun run apps/community-app/src/server.ts",
    "test": "bun test",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "build": "bun run --workspaces --if-present build"
  },
  "dependencies": {
    "@fenix/app-platform": "workspace:*",
    "@fenix/community-app": "workspace:*",
    "@fenix/community-app-kit": "workspace:*",
    "@fenix/enterprise-app": "workspace:*",
    "@fenix/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
